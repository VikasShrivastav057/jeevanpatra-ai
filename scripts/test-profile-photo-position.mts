import assert from 'node:assert/strict';
import { readProfilePhotoMove, isProfilePhotoSummary } from '../lib/profile-photo-position';
import { isPhotoAdjustment } from '../lib/photo-adjustment';
import { applyFinishingPlan, directFinishingPlan, FinishingPlanError, type FinishContext } from '../lib/finishing-plan';
const prompt='Move the circular profile photo slightly to the right and slightly downward by about 1%. Keep the same size, circular golden frame, cropping, and overall style unchanged. Ensure the photo remains properly aligned and balanced within the design. Do not change the face, background design, Radha Krishna artwork, flowers, borders, or any other element of the biodata.';
const ctx: FinishContext={instruction:prompt,introduction:'',fields:[{id:'name',label:'Name',section:'personal',hasValue:true}],template:'mahadev-parvati-devotional',mode:'requested-only',targets:['layout','colors','photo','header'],design:{name:'Existing',note:'Preserve',primary:'#123456',accent:'#ac9955',paper:'#fffaf0',text:'#123456',borderStyle:'classic',photoShape:'circle',layout:'classic',fontStyle:'traditional',density:'balanced',blessing:'ॐ नमः शिवाय',blessingOverride:'Jai Shri RadhaKrishna',blessingOffsetX:2,blessingOffsetY:3,artwork:'radha-krishna-replacement',editedProperties:[]},visuals:{frameStyle:'template',backgroundStyle:'template',colors:{primary:'#123456',accent:'#ac9955',paper:'#fffaf0',text:'#123456'},profilePhoto:{offset:{x:0,y:0},bounds:{x:15.6,y:18.1,width:25.8,height:18.2}}}};
let count=0;
function check(name:string,test:()=>void){test();count++;}
const run=(instruction:string,override:Partial<FinishContext>={})=>{const c={...structuredClone(ctx),...override,instruction};const before=structuredClone(c);const r=applyFinishingPlan(directFinishingPlan(c),c);assert.deepEqual(c,before);return r;};
check('exact customer prompt',()=>{const r=run(prompt);assert.deepEqual(r.visuals.profilePhoto?.offset,{x:1,y:1});assert.deepEqual(r.design,ctx.design);assert.deepEqual(r.fieldUpdates,[]);assert.deepEqual(r.fieldOrder,['name']);assert.equal(r.changes.length,2);assert.deepEqual(r.visuals.colors,ctx.visuals.colors);assert.deepEqual(r.visuals.profilePhoto?.bounds,ctx.visuals.profilePhoto?.bounds);});
for(const [text,expected]of [['Move my photo left by 1% and up by 2%.',{x:-1,y:-2}],['Move the profile photo 0.5% right and 1.5% down.',{x:.5,y:1.5}],['Nudge my photo right.',{x:1}],['Move my photo downward by about 1%.',{y:1}]] as const)check(text,()=>assert.deepEqual(readProfilePhotoMove(text),expected));
check('relative to saved offset',()=>{const c=structuredClone(ctx);c.visuals.profilePhoto!.offset={x:2,y:-1};assert.deepEqual(run(prompt,c).visuals.profilePhoto?.offset,{x:3,y:0});});
for(const text of ['Move my photo 2px right.','Move my photo -1% right.','Move my photo right and left by 1%.','Move my photo 1%.','Move my photo 21% right.'])check('reject '+text,()=>assert.throws(()=>readProfilePhotoMove(text)));
check('no profile photo',()=>assert.throws(()=>run(prompt,{visuals:{...ctx.visuals,profilePhoto:undefined}}),FinishingPlanError));
check('page boundary',()=>{const c=structuredClone(ctx);c.visuals.profilePhoto!.bounds.x=74.2;assert.throws(()=>run(prompt,c),FinishingPlanError);});
check('position preservation conflict',()=>assert.throws(()=>run('Move my photo right 1%. Keep photo position unchanged.'),FinishingPlanError));
const raw=(target:string,value:unknown,evidence=prompt)=>({operations:[{target,value,evidence}],unfulfilled:[]});
check('cannot silently omit one axis',()=>assert.throws(()=>applyFinishingPlan(raw('profilePhoto.offsetX',1),ctx),FinishingPlanError));
check('wrong amount rejected',()=>assert.throws(()=>applyFinishingPlan({operations:[{target:'profilePhoto.offsetX',value:2,evidence:prompt},{target:'profilePhoto.offsetY',value:1,evidence:prompt}],unfulfilled:[]},ctx),FinishingPlanError));
check('movement does not authorise shape change',()=>assert.throws(()=>applyFinishingPlan(raw('design.photoShape','square'),ctx),FinishingPlanError));
check('blessing movement cannot move photo',()=>assert.throws(()=>applyFinishingPlan(raw('profilePhoto.offsetX',1,'Move the blessing text right by 1%.'),{...ctx,instruction:'Move the blessing text right by 1%.'}),FinishingPlanError));
check('uploaded image is separate',()=>assert.equal(readProfilePhotoMove('Move my uploaded photo right by 1%.'),undefined));
check('moving a crop cannot move the frame',()=>assert.throws(()=>readProfilePhotoMove('Move my profile photo crop right by 1%.')));
check('compound style and photo movement',()=>{const r=run('Move my photo right 1% and use a modern font. Keep the photo size, crop and artwork unchanged.');assert.equal(r.design.fontStyle,'modern');assert.equal(r.design.artwork,ctx.design.artwork);assert.deepEqual(r.visuals.profilePhoto?.offset,{x:1,y:0});assert.equal(r.changes.length,2);});
check('offset-only persistence preserves default crop',()=>{assert.equal(isPhotoAdjustment({offset:{x:1,y:1}}),true);assert.equal(isPhotoAdjustment({offset:{x:Infinity,y:1}}),false);assert.equal(isPhotoAdjustment({offset:{x:21,y:1}}),false);assert.equal(isPhotoAdjustment({offset:{x:1,y:1,src:'other'}}),false);});
check('no private image data in photo summary',()=>{assert.equal(isProfilePhotoSummary(ctx.visuals.profilePhoto),true);assert.equal(isProfilePhotoSummary({...ctx.visuals.profilePhoto,src:'other'}),false);assert.equal(isProfilePhotoSummary({...ctx.visuals.profilePhoto,bounds:{x:90,y:0,width:20,height:20}}),false);});
console.log(`${count} exact-photo-prompt, axes, percentages, preservation, bounds and persistence checks passed.`);
