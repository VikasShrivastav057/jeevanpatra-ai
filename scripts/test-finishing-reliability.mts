import assert from 'node:assert/strict';
import { applyFinishingPlan, directFinishingPlan, FinishingPlanError, type FinishContext } from '../lib/finishing-plan';
const ctx: FinishContext = { instruction: '', introduction: 'I enjoy reading.', template: 'classic-red', mode: 'requested-only', targets: [], design: { name: 'Current', note: 'Preserve', primary: '#123456', accent: '#987654', paper: '#fffaf0', text: '#112233', borderStyle: 'classic', photoShape: 'circle', layout: 'classic', fontStyle: 'traditional', density: 'airy', blessing: 'ॐ नमः शिवाय', editedProperties: [] }, fields: [{ id: 'job', label: 'Profession', section: 'personal', hasValue: true }, { id: 'edu', label: 'Education', section: 'personal', hasValue: true }, { id: 'phone', label: 'Phone', section: 'contact', hasValue: true }], visuals: { frameStyle: 'rounded', backgroundStyle: 'template', colors: { primary: '#123456', accent: '#987654', paper: '#fffaf0', text: '#112233' } } };
const op = (target: string, value: unknown, evidence: string, id?: string) => ({ target, value, evidence, ...(id ? { id } : {}) });
const apply = (instruction: string, operations: unknown[]) => applyFinishingPlan({operations, unfulfilled: []}, {...structuredClone(ctx), instruction});
let count=0, failures=0;
function check(name: string, test: () => void) { count++; try { test(); } catch(error) { failures++; console.error(name, error instanceof Error ? error.message.slice(0,300) : error); } }
for(const instruction of ['Use a modern font, keep all colours and pictures unchanged.', 'Use a modern font and keep everything else the same.', 'Please use a modern font; do not change the photo.', 'Keep the image unchanged, but make the font modern.', 'Use a modern font without changing the photo.', 'Use a modern font keeping the photos unchanged.']) check(instruction,()=>assert.equal(apply(instruction,[op('design.fontStyle','modern',instruction)]).design.fontStyle,'modern'));
check('reorder and preserve in one sentence',()=>assert.deepEqual(apply('Move Education above Profession and keep the field values unchanged.',[op('fieldOrder',['edu','job','phone'],'Move Education above Profession and keep the field values unchanged.')]).fieldOrder,['edu','job','phone']));
for(const instruction of ['Replace "ॐ नमः शिवाय" with "Jai Shri RadhaKrishna".', 'Rename "Phone" to "Mobile number".', 'Move Phone into personal details.', 'Use a dotted background print.', 'Change body text colour to #223344.']) check('omission: '+instruction,()=>assert.throws(()=>apply(instruction,[]),FinishingPlanError));
check('contradiction still rejected',()=>assert.throws(()=>apply('Use a modern font, keep the font unchanged.',[op('design.fontStyle','modern','Use a modern font')]),FinishingPlanError));
check('quoted preservation words are content',()=>assert.equal(apply('Replace "ॐ नमः शिवाय" with "Keep faith". Keep everything else unchanged.',[op('design.blessingOverride','Keep faith','Replace "ॐ नमः शिवाय" with "Keep faith"')]).design.blessingOverride,'Keep faith'));
for(const [instruction,target,value] of [['Use a modern font.','design.fontStyle','modern'],['Make the profile photo square.','design.photoShape','square'],['Make my name larger.','design.nameSize','large'],['Make the border oval.','frameStyle','oval'],['Use a dotted background print.','backgroundStyle','dots'],['Reduce spacing.','design.density','compact'],['Change only the heading colour to #84252b.','design.primary','#84252b']] as const) check('direct: '+instruction,()=>{const result=applyFinishingPlan(directFinishingPlan({...ctx,instruction}),{...ctx,instruction});assert.equal(result.changes.length,1);assert.equal(result.changes[0].target,target+':');assert.equal(result.changes[0].after,value);assert.deepEqual(result.fieldUpdates,[]);assert.equal(result.introduction,ctx.introduction);});
check('wrong enum value rejected',()=>assert.throws(()=>apply('Make the profile photo square.',[op('design.photoShape','rounded','Make the profile photo square')]),FinishingPlanError));
check('unsupported extra is not silently dropped',()=>assert.throws(()=>apply('Use a modern font and add a QR code.',[op('design.fontStyle','modern','Use a modern font')]),FinishingPlanError));
check('values cannot silently be omitted',()=>assert.throws(()=>apply('Change my Phone number to 12345.',[]),FinishingPlanError));
check('direct compound style edits',()=>{const instruction='Use a modern font, make the profile photo square and reduce spacing. Keep the colours and field values unchanged.';const result=applyFinishingPlan(directFinishingPlan({...ctx,instruction}),{...ctx,instruction});assert.deepEqual(result.changes.map(c=>c.target),['design.fontStyle:','design.photoShape:','design.density:']);});
check('quoted punctuation and commands stay text',()=>{const instruction='Replace "ॐ नमः शिवाय" with "Faith, keep love. And use hope". Keep everything else unchanged.';assert.equal(apply(instruction,[op('design.blessingOverride','Faith, keep love. And use hope',instruction)]).design.blessingOverride,'Faith, keep love. And use hope');});
check('unsupported compound rejected before provider',()=>assert.throws(()=>directFinishingPlan({...ctx,instruction:'Use a modern font with a QR code.'}),FinishingPlanError));
check('non-field IDs cannot alter review targets',()=>assert.equal(apply('Use a modern font.',[op('design.fontStyle','modern','Use a modern font','design.fontStyle')]).changes[0].target,'design.fontStyle:'));
check('non-field IDs cannot bypass conflicts',()=>assert.throws(()=>apply('Use a modern font.',[op('design.fontStyle','modern','Use a modern font','one'),op('design.fontStyle','traditional','Use a modern font','two')]),FinishingPlanError));
check('unambiguous target aliases are canonical',()=>assert.equal(apply('Make the border oval.',[op('design.frameStyle','oval','Make the border oval')]).visuals.frameStyle,'oval'));
check('overlapping labels cannot target a different field',()=>{const instruction='Rename "Preferred Profession" to "Career preference".';assert.throws(()=>applyFinishingPlan({operations:[op('field.label','Career preference',instruction,'job')],unfulfilled:[]},{...ctx,instruction,fields:[...ctx.fields,{id:'preferred',label:'Preferred Profession',section:'preferences',hasValue:true}]}),FinishingPlanError);});
check('destination heading is not a source field',()=>{const instruction='Group Education under Profession.';assert.throws(()=>apply(instruction,[op('field.group','Profession',instruction,'job')]),FinishingPlanError);});
check('old custom group must clear on section move',()=>{const instruction='Move Phone into family details.';const grouped={...ctx,instruction,fields:ctx.fields.map(f=>f.id==='phone'?{...f,group:'Old group'}:f)};assert.throws(()=>applyFinishingPlan({operations:[op('field.section','family',instruction,'phone')],unfulfilled:[]},grouped),FinishingPlanError);const result=applyFinishingPlan({operations:[op('field.section','family',instruction,'phone'),op('field.group','',instruction,'phone')],unfulfilled:[]},grouped);assert.deepEqual(result.fieldUpdates,[{id:'phone',section:'family',group:''}]);});
check('wrong destination section rejected',()=>assert.throws(()=>apply('Move Phone into family details.',[op('field.section','contact','Move Phone into family details','phone')]),FinishingPlanError));
check('DOB alias keeps exact replacement label',()=>{const instruction='Rename "DOB" to "Birth date".';const result=applyFinishingPlan({operations:[op('field.label','Birth date',instruction,'dob')],unfulfilled:[]},{...ctx,instruction,fields:[{id:'dob',label:'Date of birth',section:'personal',hasValue:true}]});assert.deepEqual(result.fieldUpdates,[{id:'dob',label:'Birth date'}]);});
check('multiline heading evidence preserves named list context',()=>{const instruction='Arrange personal fields in this sequence:\nEducation\nProfession\nUse a modern font.';const result=apply(instruction,[op('fieldOrder',['edu','job','phone'],'Arrange personal fields in this sequence:'),op('design.fontStyle','modern','Use a modern font')]);assert.deepEqual(result.fieldOrder,['edu','job','phone']);});
if(failures)throw new Error(`${failures}/${count} finishing reliability checks failed.`);
console.log(`${count} natural phrasing and complete-request checks passed.`);
